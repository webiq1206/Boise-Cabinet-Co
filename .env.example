# Copy to .env.local for local dev and builds (see .env.local in repo for defaults)

# Required for admin sessions & quote edit tokens (32+ characters)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# PostgreSQL — required for portal, design saves, and partner features
# Replit: enabled automatically with the postgresql-16 module (host: helium)
# Local: copy to .env.local and run `npm run db:push`
# DATABASE_URL=postgresql://postgres:password@helium/heliumdb?sslmode=disable

# Public site (override before launch)
# NEXT_PUBLIC_SITE_URL=https://boisecabinet.co
# NEXT_PUBLIC_PHONE=(208) 477-1169
# NEXT_PUBLIC_EMAIL=hello@boisecabinet.co

# Analytics & search engine verification
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1HD7RT8PKJ
# NEXT_PUBLIC_GSC_VERIFICATION=

# Local SEO trust signals (shared/siteConfig.ts + lib/schema.ts)
# Set after GBP verification — see docs/GBP-SETUP-GUIDE.md Section 11
# NEXT_PUBLIC_LICENSE_NUMBER=
# NEXT_PUBLIC_GBP_URL=https://maps.google.com/?cid=YOUR_CID_HERE
# NEXT_PUBLIC_HOUZZ_URL=
# NEXT_PUBLIC_BBB_URL=
# NEXT_PUBLIC_YELP_URL=
# NEXT_PUBLIC_REVIEW_RATING=4.9
# NEXT_PUBLIC_REVIEW_COUNT=12

# Stripe — customer invoice payments in portal + partner lead purchases
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Partner network emails (comma-separated, assigned partner role on login)
# PARTNER_EMAILS=installer@example.com

# Email (consultation & pricing request notifications)
# RESEND_API_KEY=

# Address autocomplete (Google Places) — recommended for production
# GOOGLE_MAPS_API_KEY=

# Design Studio — photo room size estimate (scan-room API)
# OPENAI_API_KEY=

# Conversational estimating assistant (docs/ESTIMATING-SYSTEM.md)
# Without ANTHROPIC_API_KEY the chat widget hides entirely; the site works as before.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5

# Design Studio is hidden from the public site while it is rebuilt.
# Set to "true" to re-enable the /design-studio route + navigation/CTAs (e.g. local dev).
# NEXT_PUBLIC_DESIGN_STUDIO_ENABLED=true

# OIDC auth (Replit or compatible provider)
# REPL_ID=
# ISSUER_URL=
